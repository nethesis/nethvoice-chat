# The gateway is a static Go binary; only a CA bundle is needed for HTTPS to the push services.
# It runs under rootless podman: root in here is the module's unprivileged user on the host.
FROM docker.io/library/alpine:3.22 AS certs
RUN apk add --no-cache ca-certificates
FROM scratch
COPY --from=certs /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY chat-gateway /chat-gateway
VOLUME /data
ENTRYPOINT ["/chat-gateway"]
